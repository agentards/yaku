{
  "name": "yaku-relay-proto-offline-qr",
  "version": "1.0.0",
  "description": "Prototipo de validación Yaku Relay: PWA offline + relevo QR + mapa Piura",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc",
    "test": "vite build && vitest run",
    "measure:qr": "vite-node scripts/qr-measure.ts",
    "e2e": "vite build && node scripts/e2e.mjs",
    "prep:data": "node scripts/prep-data.mjs",
    "e2e:desktop": "vite build && VIEWPORT=desktop node scripts/e2e.mjs",
    "e2e:3d": "vite build && node scripts/e2e-3d.mjs",
    "e2e:3d-vista": "vite build && node scripts/e2e-3d-vista.mjs",
    "screens": "node scripts/screens.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "e2e:portal": "vite build && node scripts/e2e-portal.mjs",
    "e2e:municipalidad": "vite build && node scripts/e2e-municipalidad.mjs",
    "e2e:incidentes": "vite build && node scripts/e2e-incidentes.mjs",
    "e2e:poblador": "node scripts/e2e-poblador.mjs",
    "e2e:poblador:real": "node scripts/e2e-poblador.mjs --real",
    "e2e:rutas": "vite build && node scripts/e2e-rutas.mjs",
    "servidor": "vite build && node servidor-local/empaquetar.mjs && node servidor-local/salida/servidor.mjs",
    "servidor:dev": "node servidor-local/servidor.ts",
    "build:servidor": "node servidor-local/empaquetar.mjs",
    "test:servidor": "node --test \"servidor-local/pruebas/*.test.ts\"",
    "typecheck:servidor": "tsc --noEmit -p servidor-local",
    "e2e:sesion": "vite build && node scripts/e2e-sesion.mjs",
    "e2e:estamos-bien": "vite build && node scripts/e2e-estamos-bien.mjs",
    "e2e:envio": "vite build && node scripts/e2e-envio.mjs",
    "qa:despliegue": "node scripts/qa-despliegue.mjs",
    "qa:produccion": "node scripts/qa-produccion.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "gsap": "3.15.0",
    "idb": "^8.0.4",
    "jsqr": "^1.4.0",
    "lenis": "1.3.26",
    "maplibre-gl": "^6.14.0",
    "pako": "^3.0.2",
    "pmtiles": "^4.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "fake-indexeddb": "^6.2.6",
    "mapshaper": "^0.7.88",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
