# Copiar a .env junto a docker-compose.yml (el .env no se sube al repo) y completar.
# PIN del Centro de monitoreo (lo escribe el personal municipal al entrar). Usa uno largo.
MUNI_PIN=
# Dominio público. DNS: registros A de yaku.lat y de www.yaku.lat a la IP del VPS (www redirige a yaku.lat).
YAKU_HOST=yaku.lat
# Correo para Let's Encrypt (solo si usas el perfil «traefik» de este compose).
ACME_EMAIL=
# false = la red «traefik» no existe todavía y la crea compose (VPS limpio con --profile traefik).
TRAEFIK_EXTERNA=true
# Si tu Traefik usa otros nombres, cámbialos aquí:
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
