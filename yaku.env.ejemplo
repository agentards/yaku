# Copiar a .env junto a docker-compose.yml (en Dokploy: pestaña Environment). El .env nunca va al repo.
# PIN del Centro de monitoreo (lo escribe quien entra a /municipalidad). Obligatorio. Varias personas usan el mismo.
MUNI_PIN=
# 0 (por defecto) = modo MVP: solo el PIN. 1 = modo estricto: bloqueo por intentos de PIN, histórico privado,
# límites de escritura, cuotas de fotos, sin CORS y cabeceras de seguridad.
# YAKU_MODO_ESTRICTO=0
# Dominio público. DNS: registros A de yaku.lat y de www.yaku.lat a la IP del VPS (www redirige a yaku.lat).
YAKU_HOST=yaku.lat
# Red de Traefik a la que se conecta Yaku. Dokploy: dokploy-network. Otro Traefik: el nombre de su red.
TRAEFIK_NETWORK=dokploy-network
# true = esa red ya existe (Dokploy, Easypanel, Coolify). false = VPS limpio: compose la crea y, con
# «--profile traefik», levanta también su propio Traefik (entonces define ACME_EMAIL).
TRAEFIK_EXTERNA=true
# ACME_EMAIL=
# Solo si tu Traefik usa otros nombres (Dokploy usa estos):
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_ENTRYPOINT_HTTP=web
# TRAEFIK_CERTRESOLVER=letsencrypt
